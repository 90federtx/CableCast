<ui:FluentWindow x:Class="CableCast.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:loc="clr-namespace:CableCast.Services"
        xmlns:local="clr-namespace:CableCast.Views"
        Title="CableCast" Width="1000" Height="680" MinWidth="820" MinHeight="560"
        WindowStartupLocation="CenterScreen" ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica" Icon="pack://application:,,,/Resources/app.ico">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="CableCast"
                     Icon="pack://application:,,,/Resources/app.png" />

        <Border Grid.Row="1" x:Name="UpdateBanner" Visibility="Collapsed" Padding="16,8"
                Background="{DynamicResource ControlFillColorSecondaryBrush}">
            <DockPanel>
                <ui:Button DockPanel.Dock="Right" Content="{loc:L Update_Dismiss}" Click="OnDismissUpdate" Margin="8,0,0,0" />
                <ui:Button DockPanel.Dock="Right" Content="{loc:L Update_Download}" Appearance="Primary" Click="OnDownloadUpdate" />
                <TextBlock x:Name="UpdateText" TextWrapping="Wrap" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
            </DockPanel>
        </Border>

        <ui:NavigationView Grid.Row="2" x:Name="RootNavigation" PaneDisplayMode="Left"
                           IsBackButtonVisible="Collapsed" IsPaneToggleVisible="False"
                           OpenPaneLength="200" Transition="FadeInWithSlide">
            <ui:NavigationView.MenuItems>
                <ui:NavigationViewItem Content="{loc:L Nav_Home}" Icon="{ui:SymbolIcon Phone24}" TargetPageType="{x:Type local:HomePage}" />
                <ui:NavigationViewItem Content="{loc:L Nav_Settings}" Icon="{ui:SymbolIcon Settings24}" TargetPageType="{x:Type local:SettingsPage}" />
                <ui:NavigationViewItem Content="{loc:L Nav_Profiles}" Icon="{ui:SymbolIcon PersonBoard24}" TargetPageType="{x:Type local:ProfilesPage}" />
                <ui:NavigationViewItem Content="{loc:L Nav_Phones}" Icon="{ui:SymbolIcon BookQuestionMark24}" TargetPageType="{x:Type local:PhonesPage}" />
                <ui:NavigationViewItem Content="{loc:L Nav_Log}" Icon="{ui:SymbolIcon TextAlignLeft24}" TargetPageType="{x:Type local:LogPage}" />
            </ui:NavigationView.MenuItems>
            <ui:NavigationView.FooterMenuItems>
                <ui:NavigationViewItem Content="{loc:L Nav_About}" Icon="{ui:SymbolIcon Info24}" TargetPageType="{x:Type local:AboutPage}" />
            </ui:NavigationView.FooterMenuItems>
        </ui:NavigationView>
    </Grid>
</ui:FluentWindow>
