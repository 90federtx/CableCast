<Page Foreground="{DynamicResource TextFillColorPrimaryBrush}" ScrollViewer.VerticalScrollBarVisibility="Disabled" x:Class="CableCast.Views.AboutPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:loc="clr-namespace:CableCast.Services">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Background="Transparent" loc:WheelScroll.Enabled="True">
        <StackPanel Margin="32,24,32,24" MaxWidth="720" HorizontalAlignment="Left">
            <ui:TextBlock Text="{loc:L About_Title}" FontTypography="Title" Margin="0,0,0,4" />
            <ui:TextBlock x:Name="VersionText" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,16" />
            <ui:TextBlock Text="{loc:L About_Description}" TextWrapping="Wrap" Margin="0,0,0,20" />

            <ui:TextBlock Text="{loc:L About_Credits}" FontTypography="Subtitle" Margin="0,0,0,8" />
            <ui:TextBlock x:Name="ScrcpyText" TextWrapping="Wrap" Margin="0,0,0,4" />
            <ui:TextBlock x:Name="ShaText" FontFamily="Consolas" FontSize="12" TextWrapping="Wrap"
                          Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,12" />
            <ui:TextBlock Text="{loc:L About_OtherCredits}" TextWrapping="Wrap" Margin="0,0,0,20" />

            <StackPanel Orientation="Horizontal">
                <ui:Button Content="{loc:L About_OpenScrcpy}" Click="OpenScrcpy_Click" />
                <ui:Button Content="{loc:L About_OpenNotices}" Click="OpenNotices_Click" Margin="8,0,0,0" />
                <ui:Button Content="{loc:L About_OpenScrcpyLicense}" Click="OpenScrcpyLicense_Click" Margin="8,0,0,0" />
            </StackPanel>
            <ui:TextBlock x:Name="ErrorText" Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                          TextWrapping="Wrap" Margin="0,12,0,0" Visibility="Collapsed" />
        </StackPanel>
    </ScrollViewer>
</Page>
