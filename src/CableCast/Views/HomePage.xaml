<Page Foreground="{DynamicResource TextFillColorPrimaryBrush}" x:Class="CableCast.Views.HomePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:loc="clr-namespace:CableCast.Services">
    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Page.Resources>
    <StackPanel Margin="32,24,32,24" MaxWidth="720" HorizontalAlignment="Left">
        <ui:TextBlock Text="{loc:L Home_Title}" FontTypography="Title" Margin="0,0,0,16" />
        <ui:Card Padding="24">
            <StackPanel>
                <ui:TextBlock Text="{Binding Title}" FontTypography="Subtitle" TextWrapping="Wrap" />
                <ui:TextBlock Text="{Binding Text}" Margin="0,8,0,0" TextWrapping="Wrap"
                              Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                <StackPanel Margin="0,16,0,0" Visibility="{Binding ShowDeviceSelector, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="{loc:L Home_SelectDevice}" Margin="0,0,0,4" />
                    <ComboBox ItemsSource="{Binding Devices}" DisplayMemberPath="SelectionName"
                              SelectedValuePath="Serial" SelectedValue="{Binding SelectedDeviceSerial, Mode=TwoWay}"
                              MinWidth="280" HorizontalAlignment="Left" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
                    <ui:Button Content="{Binding MirrorButtonText}" Command="{Binding StartStopCommand}" Appearance="Primary" />
                    <ui:Button Content="{loc:L Home_CheckNow}" Command="{Binding CheckNowCommand}" Margin="8,0,0,0" />
                    <ui:Button Content="{loc:L Home_OpenWizard}" Command="{Binding OpenWizardCommand}" Margin="8,0,0,0"
                               Visibility="{Binding ShowWizardButton, Converter={StaticResource BoolToVis}}" />
                </StackPanel>
            </StackPanel>
        </ui:Card>
    </StackPanel>
</Page>
